#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH="$(readlink -f "$0")"
real_npm="$(command -v npm 2>/dev/null || true)"
if [[ -n "$real_npm" && "$real_npm" != "$SCRIPT_PATH" ]]; then
  exec "$real_npm" "$@"
fi
if command -v bun >/dev/null 2>&1; then
  if [[ "${1:-}" == "run" && $# -ge 2 ]]; then
    shift
    exec bun run "$@"
  else
    exec bun "$@"
  fi
fi
echo "npm is not installed in this environment and no fallback (Bun) is available." >&2
echo "Install Node.js/npm or use Bun (https://bun.sh) to run project scripts." >&2
exit 127
